    "def run_complete_pipeline():\n",
    "    '''Run the complete pipeline from feature extraction to prediction'''\n",
    "    # Step 1: Verify audio files exist\n",
    "    if not os.path.exists(AUDIO_DIR) or len(os.listdir(AUDIO_DIR)) == 0:\n",
    "        print('No audio files available for processing. Please add audio files to the audio directory.')\n",
    "        return\n",
    "        \n",
    "    # Step 2: Extract features from training data\n",
    "    print('Step 1: Extracting features from training data...')\n",
    "    train_features_df = extract_all_features(train_df, AUDIO_DIR, is_train=True)\n",
    "    \n",
    "    if train_features_df is None or len(train_features_df) == 0:\n",
    "        print('No features extracted from training data. Cannot continue.')\n",
    "        return\n",
    "    \n",
    "    # Step 3: Train models\n",
    "    print('\nStep 2: Training and evaluating models...')\n",
    "    models, scaler, results_df = train_and_evaluate_models(train_features_df)\n",
    "    \n",
    "    if models is None or results_df is None:\n",
    "        print('Model training failed. Cannot continue.')\n",
    "        return\n",
    "    \n",
    "    # Step 4: Find the best model based on validation RMSE\n",
    "    print('\nStep 3: Finding the best model...')\n",
    "    best_model_name = find_best_model(results_df)\n",
    "    \n",
    "    # Step 5: Tune the best model\n",
    "    print('\nStep 4: Tuning the best model...')\n",
    "    best_model, best_scaler = tune_best_model(train_features_df, best_model_name, models)\n",
    "    \n",
    "    if best_model is None:\n",
    "        print('Model tuning failed. Cannot continue.')\n",
    "        return\n",
    "    \n",
    "    # Step 6: Extract features from test data\n",
    "    print('\nStep 5: Extracting features from test data...')\n",
    "    test_features_df = extract_all_features(test_df, AUDIO_DIR, is_train=False)\n",
    "    \n",
    "    if test_features_df is None or len(test_features_df) == 0:\n",
    "        print('No features extracted from test data. Cannot continue.')\n",
    "        return\n",
    "    \n",
    "    # Step 7: Make predictions on test data\n",
    "    print('\nStep 6: Making predictions on test data...')\n",
    "    submission_df = predict_on_test_data(test_features_df, best_model, best_scaler)\n",
    "    \n",
    "    # Step 8: Calculate RMSE on training data (as required by the competition)\n",
    "    X_train = train_features_df.drop(['file_name', 'grammar_score'], axis=1)\n",
    "    y_train = train_features_df['grammar_score']\n",
    "    X_train_scaled = best_scaler.transform(X_train)\n",
    "    y_train_pred = best_model.predict(X_train_scaled)\n",
    "    train_rmse = np.sqrt(mean_squared_error(y_train, y_train_pred))\n",
    "    \n",
    "    print(f'\nFinal Training RMSE: {train_rmse:.4f}')\n",
    "    print('\nComplete pipeline execution finished!')\n",
    "\n",
